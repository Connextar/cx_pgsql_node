# One app container on this server. Copy to config/apps/<app>.env (e.g. cx-support-relay.env) and
# edit; `bin/remote.sh apply` checks out APP_REF, builds the image, starts it on loopback and serves it
# on https://APP_FQDN through nginx, with a Let's Encrypt certificate once APP_FQDN's A record points
# here. More: docs/Apps.md.
#
# Not a place for secrets: name them in APP_SECRETS and set their values on the server with
#   bin/remote.sh app-secrets <app> [--from <file>]
# (asked for, never shown or put on a command line).

# The app's name (default: this file's name without .env). Lowercase letters, digits and dashes.
APP_NAME=cx-support-relay
# The public name it is served on (HTTPS). Its DNS A record must point at SERVER_IP.
APP_FQDN=relay.support.connextar.com

# Where its code comes from: a git URL. Over SSH (git@github.com:owner/repo.git), the server uses a
# read-only deploy key of its own for this app: `bin/remote.sh app-key <app> [--github]`.
APP_REPO=git@github.com:Connextar/cx-support.git
# The branch or tag that is deployed. `apply` builds what is checked out; a newer commit on a branch
# goes live with `bin/remote.sh app-deploy <app>`, never by itself.
APP_REF=main
# The Dockerfile and build context, relative to the repository's root.
APP_DOCKERFILE=services/voice-relay/Dockerfile
APP_CONTEXT=.

# The port nginx reaches it on (host loopback only; unique on this server) and the one it listens on
# inside its container.
APP_PORT=28510
APP_CONTAINER_PORT=8787
# A path that answers 200 when it's up (checked on loopback and through nginx).
APP_HEALTH_PATH=/healthz
# Long-lived WebSocket connections: nginx passes the upgrade on and waits up to an hour.
APP_WEBSOCKET=true
# Requests per second per address at nginx, and the burst allowed above it.
APP_RATE_LIMIT=10r/s
APP_RATE_BURST=40
# Container limits.
APP_MEMORY_LIMIT=512m
APP_CPUS=1.0

# Secret settings, by name (space-separated). Their values are kept on the server only.
APP_SECRETS="VOICE_SESSION_PUBLIC_KEY TWILIO_AUTH_TOKEN ANTHROPIC_API_KEY"
# Every other setting it reads, one NAME=value a line.
APP_ENV="
VOICE_APP_URL=https://support.connextar.com
VOICE_RELAY_URL=wss://relay.support.connextar.com/relay
RELAY_TWILIO_SIGNATURE=enforce
ANTHROPIC_EFFORT=low
RELAY_CALLS_PER_TENANT=20
RELAY_PENDING_SOCKETS=50
"

# One database on this server. Copy to config/databases/<name>.env (e.g. alted.env) and edit;
# `setup.sh apply databases` creates it, its login and its PgBouncer entries. The password is
# generated on the server: `cx-pgsql db url <name> --show-password` prints the connection strings.

# Database name (default: this file's name without .env). Lowercase, digits, underscores.
DB_NAME=alted
# Owner login (default: DB_NAME). It owns the database and its public schema.
DB_USER=alted
# Extensions created in the database (space-separated), e.g. "pgcrypto citext pg_trgm".
DB_EXTENSIONS=""
# PgBouncer: server connections for this database in transaction mode, and in session mode
# (the <name>_session entry, for migrations, advisory locks and LISTEN/NOTIFY).
DB_POOL_SIZE=20
DB_SESSION_POOL_SIZE=5
# Most connections this login may hold on Postgres itself (-1 = no limit).
DB_CONNECTION_LIMIT=-1
# Statement timeout for the login, e.g. 60s (empty = none).
DB_STATEMENT_TIMEOUT=""
# Optional read-only login (SELECT on the public schema, now and for future tables).
DB_READONLY_USER=""
# Reachable through PgBouncer (true) or only directly (false).
DB_PGBOUNCER=true
# Included in the nightly dumps and the weekly restore test.
DB_BACKUP=true

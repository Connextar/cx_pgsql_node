# One app's object storage on this server. Copy to config/objects/<app>.env (e.g. alted.env) and
# edit; `setup.sh apply objects` creates its buckets and one access key allowed on those buckets
# only. The key is generated on the server: `cx-pgsql objects key <app> --show-secret` prints the
# settings the app needs. Buckets are never deleted by the setup (`cx-pgsql objects list` flags any
# no longer in config).

# The app's name (default: this file's name without .env). Lowercase letters, digits and dashes.
OBJ_NAME=alted
# Its buckets (space-separated). Lowercase letters, digits and dashes, 3–63 characters.
OBJ_BUCKETS="alted-uploads alted-listing"
# Included in the hourly off-site copy and the weekly restore test.
OBJ_BACKUP=true

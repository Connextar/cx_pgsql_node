# CX_PGSQL_Node_1 — server configuration
#
# Copy to config/server.env and edit. Every step of ./setup.sh reads this file, and
# re-running the setup after a change applies only what differs. Nothing secret lives
# here: passwords, tokens and keys are generated on the server under SECRETS_DIR and
# never leave it (see docs/Operations.md for reading them).
#
# Values are plain shell assignments (sourced with `set -a`): quote anything with spaces.

# ─── Identity ──────────────────────────────────────────────────────────────────────
SERVER_HOSTNAME=cx-pgsql-node-1
# Public name for TLS (Postgres, PgBouncer and the health endpoint). Its DNS A record
# must point at SERVER_IP before a Let's Encrypt certificate can be issued; until then a
# self-signed certificate is used and `setup.sh status` says so.
SERVER_FQDN=psql-node-1.connextar.com
# Public IPv4 of the VPS. Used by bin/remote.sh to connect and by the TLS step to check DNS.
SERVER_IP=
TIMEZONE=UTC
LOCALE=en_GB.UTF-8
# Certbot registration and the address alerts are written for.
ADMIN_EMAIL=info@connextar.com

# ─── Optional parts ────────────────────────────────────────────────────────────────
# nvm + Node + a shared PM2 daemon (from the Contabo runbook). Off on a database node.
ENABLE_NODE_STACK=false
NODE_VERSION=lts/*
# n8n (workflow automation; also used to watch /status and send alerts). Needs N8N_FQDN.
ENABLE_N8N=false
N8N_FQDN=n8n-node-1.connextar.com
# Pinned on purpose; newer releases: https://docs.n8n.io/release-notes/
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.43.8

# ─── Base system ───────────────────────────────────────────────────────────────────
# Security updates installed automatically by unattended-upgrades. Reboots are never automatic.
AUTO_SECURITY_UPDATES=true
# Swap file size in MB (0 = none). A little swap stops the OOM killer taking Postgres on a spike.
SWAP_SIZE_MB=2048
# Cap on the systemd journal.
JOURNAL_MAX_USE=500M

# ─── Users and SSH ─────────────────────────────────────────────────────────────────
ADMIN_USER=connextar
# Groups ADMIN_USER belongs to. `ssh-users` is the only group allowed to log in over SSH.
ADMIN_GROUPS="sudo apps docker ssh-users"
# Passwordless sudo for ADMIN_USER. bin/remote.sh needs it to run the setup unattended; with
# `false`, a password is generated (secret `admin-password`) and sudo asks for it.
ADMIN_SUDO_NOPASSWD=true
# Public keys installed for ADMIN_USER, one per line (path relative to this project).
AUTHORIZED_KEYS_FILE=config/authorized_keys
# Create ~ADMIN_USER/.ssh/id_ed25519 for cloning repositories (print it with `cx-pgsql info`).
ADMIN_DEPLOY_KEY=true
GIT_USER_NAME="CX PGSQL Node 1"
GIT_USER_EMAIL=info@connextar.com

# The SSH port. 22 is closed once this is confirmed.
SSH_PORT=19225
# `no` (recommended) or `prohibit-password` (root by key only).
SSH_PERMIT_ROOT_LOGIN=no
SSH_ALLOW_GROUPS="ssh-users"
# SSH and firewall changes revert themselves after this many seconds unless confirmed from a
# NEW connection (`setup.sh confirm`; bin/remote.sh does this for you). Protects against lock-out.
ROLLBACK_SECONDS=180

# ─── Firewall (nftables) and fail2ban ──────────────────────────────────────────────
# Extra TCP ports open to the world (space-separated), beyond SSH, 80, 443 and the database port.
FIREWALL_EXTRA_TCP_PORTS=""
# Who may reach the public database port. Empty = anyone (needed for Vercel, which has no fixed
# outbound addresses); TLS + SCRAM passwords + fail2ban still apply. Example: "203.0.113.0/24 198.51.100.7"
PG_ALLOWED_CIDRS_V4=""
PG_ALLOWED_CIDRS_V6=""
# Addresses fail2ban never bans (your office/home IP, monitoring).
F2B_IGNORE_IPS=""
F2B_BANTIME=1h
F2B_MAXRETRY=5

# ─── Docker stack ──────────────────────────────────────────────────────────────────
STACK_NAME=cx-pgsql
STACK_DIR=/data/apps/cx-pgsql
DATA_ROOT=/data/psql
# Fixed bridge subnet, so pg_hba.conf can trust it (PgBouncer, health, n8n live here).
DOCKER_SUBNET=172.30.84.0/24

# PostgreSQL major version (Docker image postgres:<PG_VERSION>-<PG_IMAGE_VARIANT>). Must be ≥ the
# version of any database you import (pg_dump/pg_restore only go forwards).
PG_VERSION=17
# Debian release the Postgres and PgBouncer images are built on (trixie = Debian 13, bookworm = 12).
PG_IMAGE_VARIANT=trixie
# Host ports. The containers listen on the defaults (5432, 6432) inside Docker; the host
# publishes them on these alternative ports instead.
#   PgBouncer — what applications use (TLS required). Public unless restricted above.
PGBOUNCER_PUBLIC_PORT=28433
PGBOUNCER_BIND=0.0.0.0
#   Postgres direct — admin, pg_dump, one-off tools. Loopback only by default: reach it over
#   an SSH tunnel (`bin/remote.sh tunnel`). Set PG_DIRECT_BIND=0.0.0.0 to publish it (TLS required).
PG_DIRECT_PORT=28432
PG_DIRECT_BIND=127.0.0.1
#   Health service and n8n — loopback only; nginx serves them over HTTPS.
HEALTH_PORT=28480
N8N_PORT=28567

# Postgres tuning. `auto` sizes from the machine's RAM/CPUs (shared_buffers 25 % of RAM,
# effective_cache_size 70 %, work_mem from RAM and max_connections). Override with a value
# such as 2GB to pin one.
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=auto
PG_EFFECTIVE_CACHE_SIZE=auto
PG_WORK_MEM=auto
PG_MAINTENANCE_WORK_MEM=auto
# Log statements slower than this (ms). -1 = off.
PG_LOG_MIN_DURATION_MS=500
# Restart Postgres automatically when a changed setting needs it (otherwise status reports it).
PG_ALLOW_AUTO_RESTART=false
# Container memory limits (Docker syntax). PG_MEMORY_LIMIT=auto gives Postgres 60 % of the RAM
# (about 9.6 GB on a 16 GB server, 4.8 GB on 8 GB); the tuning above is sized from this limit.
PG_MEMORY_LIMIT=auto
PGBOUNCER_MEMORY_LIMIT=256m
HEALTH_MEMORY_LIMIT=128m
N8N_MEMORY_LIMIT=1g

# PgBouncer
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# Health thresholds (see stack/health/README.md for the full list).
HEALTH_LONG_QUERY_SECONDS=60
HEALTH_BACKUP_MAX_AGE_HOURS=26
HEALTH_UPLOAD_MAX_AGE_HOURS=26
# Return activity query text in /status (may contain personal data). Off by default.
HEALTH_INCLUDE_QUERY_TEXT=false

# ─── Backups ───────────────────────────────────────────────────────────────────────
BACKUP_ROOT=/data/backups
# Point-in-time recovery: pgBackRest base backups + continuous WAL archiving.
BACKUP_PITR=true
PGBACKREST_STANZA=main
# A full backup at least this often; differential backups on the other days.
PGBACKREST_FULL_EVERY_DAYS=7
# Full backups kept (each with the WAL needed to restore to any moment after it).
PGBACKREST_RETENTION_FULL=2
# Force a WAL switch at least this often, so at most this much is unarchived (seconds).
PG_ARCHIVE_TIMEOUT=300

# Nightly per-database pg_dump files, kept grandfather-father-son on the server.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# age public key(s) the dumps are encrypted to (space-separated `age1…` recipients). The
# matching private key stays with you, never on the server. Without a recipient, dumps are
# kept on the server only and never uploaded (unless BACKUP_UPLOAD_UNENCRYPTED_DUMPS=true).
BACKUP_AGE_RECIPIENTS=""
BACKUP_UPLOAD_UNENCRYPTED_DUMPS=false

# Schedules (systemd OnCalendar syntax, server time zone).
BACKUP_LOGICAL_SCHEDULE="*-*-* 02:00:00"
BACKUP_PHYSICAL_SCHEDULE="*-*-* 03:00:00"
BACKUP_UPLOAD_SCHEDULE="*-*-* *:20:00"
BACKUP_VERIFY_SCHEDULE="Sun *-*-* 05:00:00"
# The weekly verify also restores the newest physical backup into a throwaway container.
BACKUP_VERIFY_PITR=true

# Off-site copy with rclone. Configure the remote once with `bin/remote.sh dropbox-auth`.
BACKUP_UPLOAD=true
BACKUP_REMOTE=dropbox
# Folder inside the remote. With a Dropbox "App folder" app this is relative to Apps/<app name>/.
BACKUP_REMOTE_PATH=CX_PGSQL_Node_1
# Kept remotely (dumps; the encrypted pgBackRest repository is mirrored as-is).
BACKUP_REMOTE_KEEP_DAILY=14
BACKUP_REMOTE_KEEP_WEEKLY=8
BACKUP_REMOTE_KEEP_MONTHLY=12
# Upload bandwidth cap for rclone (e.g. 4M); empty = unlimited.
BACKUP_UPLOAD_BWLIMIT=""

# ─── bin/remote.sh (your machine only) ─────────────────────────────────────────────
# Key for SSH (empty = your ssh-agent/default keys). The first run on a fresh VPS logs in as
# BOOTSTRAP_SSH_USER on BOOTSTRAP_SSH_PORT; every later run as ADMIN_USER on SSH_PORT.
REMOTE_SSH_IDENTITY=""
BOOTSTRAP_SSH_USER=root
BOOTSTRAP_SSH_PORT=22

# ─── Paths on the server ───────────────────────────────────────────────────────────
INSTALL_DIR=/opt/cx-pgsql
SECRETS_DIR=/etc/cx-pgsql/secrets
STATE_DIR=/var/lib/cx-pgsql

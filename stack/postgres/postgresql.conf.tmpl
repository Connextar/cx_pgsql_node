# PostgreSQL configuration — rendered by `setup.sh apply stack` from
# stack/postgres/postgresql.conf.tmpl. Don't edit the rendered file: change
# config/server.env, or put overrides in conf.d/local.conf (read last, kept across runs).

# ─── Connections ───────────────────────────────────────────────────────────────
listen_addresses = '*'
port = 5432
max_connections = ${PG_MAX_CONNECTIONS}
superuser_reserved_connections = 3
password_encryption = scram-sha-256
idle_in_transaction_session_timeout = '10min'
tcp_keepalives_idle = 300

# ─── TLS (the certificate for ${SERVER_FQDN}; see lib/tls.sh) ────────────────────
ssl = on
ssl_cert_file = '/etc/cx-certs/server.crt'
ssl_key_file = '/etc/cx-certs/server.key'
ssl_min_protocol_version = 'TLSv1.2'

# ─── Memory (sized for ${PG_TUNE_RAM_MB} MB RAM, ${PG_TUNE_CPUS} CPUs) ──────────────────
shared_buffers = '${PG_TUNE_SHARED_BUFFERS}'
effective_cache_size = '${PG_TUNE_EFFECTIVE_CACHE_SIZE}'
work_mem = '${PG_TUNE_WORK_MEM}'
maintenance_work_mem = '${PG_TUNE_MAINTENANCE_WORK_MEM}'
huge_pages = try

# ─── Parallelism ───────────────────────────────────────────────────────────────
max_worker_processes = ${PG_TUNE_MAX_WORKERS}
max_parallel_workers = ${PG_TUNE_CPUS}
max_parallel_workers_per_gather = ${PG_TUNE_PARALLEL_PER_GATHER}
max_parallel_maintenance_workers = ${PG_TUNE_PARALLEL_PER_GATHER}

# ─── Storage (NVMe/SSD) ────────────────────────────────────────────────────────
random_page_cost = 1.1
effective_io_concurrency = 200
default_statistics_target = 100

# ─── WAL, checkpoints and archiving (pgBackRest) ───────────────────────────────
wal_level = replica
wal_compression = zstd
wal_buffers = '16MB'
min_wal_size = '512MB'
max_wal_size = '2GB'
checkpoint_completion_target = 0.9
checkpoint_timeout = '15min'
max_wal_senders = 3
archive_mode = ${PG_ARCHIVE_MODE}
archive_command = 'pgbackrest --stanza=${PGBACKREST_STANZA} archive-push %p'
archive_timeout = ${PG_ARCHIVE_TIMEOUT}

# ─── Autovacuum ────────────────────────────────────────────────────────────────
autovacuum_max_workers = 3
autovacuum_naptime = '30s'
autovacuum_vacuum_scale_factor = 0.05
autovacuum_analyze_scale_factor = 0.02
autovacuum_vacuum_cost_limit = 1000

# ─── Monitoring ────────────────────────────────────────────────────────────────
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.max = 5000
pg_stat_statements.track = top
track_io_timing = on
track_wal_io_timing = on
track_activity_query_size = 4096

# ─── Logging (files read by fail2ban: keep log_line_prefix in step with its filter) ─
logging_collector = on
log_directory = '/var/log/postgresql'
log_filename = 'postgresql-%a.log'
log_truncate_on_rotation = on
log_rotation_age = '1d'
log_rotation_size = 0
log_file_mode = 0640
log_line_prefix = '%m [%p] %r %q%u@%d '
log_timezone = 'UTC'
log_min_duration_statement = ${PG_LOG_MIN_DURATION_MS}
log_checkpoints = on
log_lock_waits = on
log_temp_files = '10MB'
log_autovacuum_min_duration = '10s'
log_connections = off
log_disconnections = off

# ─── Locale and time ───────────────────────────────────────────────────────────
timezone = 'UTC'
datestyle = 'iso, mdy'
lc_messages = 'C'

# ─── Local overrides (kept across setup runs) ──────────────────────────────────
include_if_exists = '/etc/postgresql/conf.d/local.conf'
